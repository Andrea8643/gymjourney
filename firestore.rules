rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function nick(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
    function prefs(p) {
      return p is map && p.keys().hasAll(['calories','macros','steps','workouts','weight'])
        && p.keys().hasOnly(['calories','macros','steps','workouts','weight','goals'])
        && p.calories is bool && p.macros is bool && p.steps is bool && p.workouts is bool && p.weight is bool && (!('goals' in p) || p.goals is bool);
    }
    function unblocked(a, b) {
      return !exists(/databases/$(database)/documents/socialProfiles/$(a)/blocks/$(b))
        && !exists(/databases/$(database)/documents/socialProfiles/$(b)/blocks/$(a));
    }
    function accepted(a, b) {
      let ab = a + '~' + b;
      let ba = b + '~' + a;
      return signed() && a != b && unblocked(a,b) && (
        (exists(/databases/$(database)/documents/friendships/$(ab))
          && get(/databases/$(database)/documents/friendships/$(ab)).data.from == a
          && get(/databases/$(database)/documents/friendships/$(ab)).data.to == b
          && get(/databases/$(database)/documents/friendships/$(ab)).data.status == 'accepted') ||
        (exists(/databases/$(database)/documents/friendships/$(ba))
          && get(/databases/$(database)/documents/friendships/$(ba)).data.from == b
          && get(/databases/$(database)/documents/friendships/$(ba)).data.to == a
          && get(/databases/$(database)/documents/friendships/$(ba)).data.status == 'accepted'));
    }
    // Original private archive: no social access is granted here.
    match /users/{userId}/{document=**} {
      allow read, write: if owner(userId);
    }
    match /socialProfiles/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['code','nickname','updatedAt'])
        && request.resource.data.keys().hasOnly(['code','nickname','updatedAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z2-7]{12}$')
        && nick(request.resource.data.nickname) && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid == uid;
      match /blocks/{other} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && other != uid
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if owner(uid);
      }
    }
    match /friendCodes/{code} {
      allow get: if signed();
      allow list: if false;
      allow create: if signed() && code.matches('^[A-Z2-7]{12}$')
        && request.resource.data.keys().hasAll(['uid','nickname','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','nickname','updatedAt'])
        && request.resource.data.uid == request.auth.uid && nick(request.resource.data.nickname)
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/socialProfiles/$(request.auth.uid)).data.code == code;
      allow update: if owner(resource.data.uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid','nickname','updatedAt'])
        && nick(request.resource.data.nickname) && request.resource.data.updatedAt == request.time;
      allow delete: if owner(resource.data.uid);
    }
    match /friendships/{id} {
      allow get, list: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // Missing documents can be read by their two named participants in a transaction.
      allow get: if signed() && !exists(/databases/$(database)/documents/friendships/$(id))
        && (id.matches('^' + request.auth.uid + '~[^/]+$') || id.matches('^[^/]+~' + request.auth.uid + '$'));
      allow create: if signed() && request.resource.data.keys().hasAll(['from','to','fromName','toName','toCode','status','createdAt'])
        && request.resource.data.keys().hasOnly(['from','to','fromName','toName','toCode','status','createdAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid && request.resource.data.to.size() <= 128
        && id == request.resource.data.from + '~' + request.resource.data.to
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && nick(request.resource.data.fromName) && nick(request.resource.data.toName)
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.toCode)).data.uid == request.resource.data.to
        && unblocked(request.auth.uid, request.resource.data.to);
      allow update: if signed() && resource.data.to == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])
        && request.resource.data.status == 'accepted' && request.resource.data.acceptedAt == request.time
        && unblocked(resource.data.from, resource.data.to);
      allow delete: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /friendShares/{uid} {
      allow get: if owner(uid) || (signed() && accepted(request.auth.uid, uid));
      allow list, delete: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['enabled','prefs','revision','nickname','updatedAt'])
        && request.resource.data.keys().hasOnly(['enabled','prefs','revision','nickname','updatedAt'])
        && request.resource.data.enabled is bool && prefs(request.resource.data.prefs)
        && nick(request.resource.data.nickname) && request.resource.data.revision is string
        && request.resource.data.revision.size() >= 12 && request.resource.data.revision.size() <= 64
        && request.resource.data.updatedAt == request.time;
      function share() { return get(/databases/$(database)/documents/friendShares/$(uid)).data; }
      function num(v, max) { return v == null || (v is number && v >= 0 && v <= max); }
      function status(s) { return s in ['completo','parziale','da_confermare','mancante','zero_confermato']; }
      function allowedFields(d, p) {
        return (!('calories' in d) || p.calories) && (!('macros' in d) || p.macros)
          && (!('steps' in d) || p.steps) && (!('workouts' in d) || p.workouts) && (!('workoutNames' in d) || p.workouts) && (!('weight' in d) || p.weight) && (!('goal' in d) || p.get('goals',true));
      }
      function validWorkoutName(a, i) { return a.size() <= i || (a[i] is string && a[i].size() <= 120); }
      function validWorkoutNames(a) { return a is list && a.size() <= 10
        && validWorkoutName(a,0) && validWorkoutName(a,1) && validWorkoutName(a,2) && validWorkoutName(a,3) && validWorkoutName(a,4)
        && validWorkoutName(a,5) && validWorkoutName(a,6) && validWorkoutName(a,7) && validWorkoutName(a,8) && validWorkoutName(a,9); }
      function goalDate(v) { return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
      function validGoal(g, date) {
        return g is map && g.keys().hasAll(['asOf','phase','status','target','arrival','from','to','far'])
          && g.keys().hasOnly(['asOf','phase','status','target','arrival','from','to','far'])
          && g.asOf == date && g.phase in ['cut','surplus','mantenimento','none']
          && g.status in ['estimated','reached','maintenance','unavailable','no_plan']
          && num(g.target,1000) && (g.target == null || g.target > 0) && g.far is bool
          && goalDate(g.arrival) && goalDate(g.from) && goalDate(g.to)
          && (g.status != 'estimated' || (g.arrival is string && g.target is number))
          && (g.status == 'estimated' || (g.arrival == null && g.from == null && g.to == null));
      }
      function validDay(d, date) {
        return d.keys().hasAll(['date','revision','updatedAt'])
          && d.keys().hasOnly(['date','revision','updatedAt','calories','macros','steps','workouts','weight','workoutNames','goal'])
          && d.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.updatedAt == request.time && d.revision == share().revision && allowedFields(d, share().prefs)
          && (!('calories' in d) || (d.calories is map && d.calories.keys().hasAll(['value','target','state']) && d.calories.keys().hasOnly(['value','target','state']) && num(d.calories.value,50000) && num(d.calories.target,50000) && status(d.calories.state)))
          && (!('macros' in d) || (d.macros is map && d.macros.keys().hasAll(['protein','carbs','fat','state']) && d.macros.keys().hasOnly(['protein','carbs','fat','state']) && num(d.macros.protein,10000) && num(d.macros.carbs,10000) && num(d.macros.fat,10000) && status(d.macros.state)))
          && (!('steps' in d) || (d.steps is map && d.steps.keys().hasAll(['value','state']) && d.steps.keys().hasOnly(['value','state']) && num(d.steps.value,200000) && status(d.steps.state)))
          && (!('workoutNames' in d) || (('workouts' in d) && validWorkoutNames(d.workoutNames) && d.workoutNames.size() <= d.workouts))
          && (!('goal' in d) || validGoal(d.goal,date))
          && (!('workouts' in d) || num(d.workouts,100)) && (!('weight' in d) || num(d.weight,1000));
      }
      match /days/{date} {
        allow get: if owner(uid) || (signed() && accepted(request.auth.uid,uid) && share().enabled
          && (!exists(/databases/$(database)/documents/friendShares/$(uid)/days/$(date))
            || (resource.data.revision == share().revision && allowedFields(resource.data, share().prefs))));
        allow list: if false;
        allow create, update: if owner(uid) && share().enabled && validDay(request.resource.data,date);
        allow delete: if owner(uid);
      }
    }
    // Optional profile photo: only the owner writes; accepted, unblocked friends read.
    match /friendAvatars/{uid} {
      allow get: if owner(uid) || (signed() && accepted(request.auth.uid, uid));
      allow list, delete: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['enabled','image','updatedAt'])
        && request.resource.data.keys().hasOnly(['enabled','image','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.image is string && request.resource.data.image.size() <= 80000
        && ((!request.resource.data.enabled && request.resource.data.image == '')
          || (request.resource.data.enabled && (request.resource.data.image == ''
            || request.resource.data.image.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))))
        && request.resource.data.updatedAt == request.time;
    }

    // Spark-only challenges. Competition has no writable point totals.
    function sparkMember(u) { return get(/databases/$(database)/documents/sparkGameMembers/$(u)).data; }
    function sparkAccess(g) {
      return signed() && request.auth.uid in g.participants && accepted(g.from,g.to)
        && sparkMember(g.from).enabled && sparkMember(g.to).enabled;
    }
    function utcDay(d) {
      let p = d.split('-');
      return timestamp.date(int(p[0]),int(p[1]),int(p[2])).toMillis();
    }
    function windowOK(g) {
      let b = g.boundaries;
      let start = utcDay(g.startDate);
      let end = utcDay(g.endDate)+86400000;
      return g.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && g.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && end-start == 604800000 && b is list && b.size() == 8
        && b[1] is int && b[2] is int && b[3] is int && b[4] is int && b[5] is int && b[6] is int
        && b[1]-b[0] >= 79200000 && b[1]-b[0] <= 93600000 && b[2]-b[1] >= 79200000 && b[2]-b[1] <= 93600000
        && b[3]-b[2] >= 79200000 && b[3]-b[2] <= 93600000 && b[4]-b[3] >= 79200000 && b[4]-b[3] <= 93600000
        && b[5]-b[4] >= 79200000 && b[5]-b[4] <= 93600000 && b[6]-b[5] >= 79200000 && b[6]-b[5] <= 93600000 && b[7]-b[6] >= 79200000 && b[7]-b[6] <= 93600000
        && b[0]-start >= -50400000 && b[0]-start <= 50400000 && b[7]-end >= -50400000 && b[7]-end <= 50400000
        && g.startMs is int && g.endMs is int && g.settleMs is int && g.startMs == b[0] && g.endMs == b[7]
        && g.startMs > request.time.toMillis() && g.startMs <= request.time.toMillis()+93600000
        && g.endMs-g.startMs >= 597600000 && g.endMs-g.startMs <= 612000000
        && g.settleMs == g.endMs+172800000;
    }
    function locksPoint(g) {
      return getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.from)).data.gameId == g.id
        && getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.to)).data.gameId == g.id;
    }
    match /sparkGameMembers/{u} {
      allow get: if owner(u) || (signed() && accepted(request.auth.uid,u));
      allow list, delete: if false;
      allow create, update: if owner(u)
        && request.resource.data.keys().hasAll(['enabled','timezone','frame','title','updatedAt'])
        && request.resource.data.keys().hasOnly(['enabled','timezone','frame','title','updatedAt'])
        && request.resource.data.enabled is bool && request.resource.data.timezone is string
        && request.resource.data.timezone.size() >= 1 && request.resource.data.timezone.size() <= 64
        && request.resource.data.frame in ['base','violet','electric','gold','aurora']
        && request.resource.data.title in ['', 'Un giorno alla volta','In movimento','Costante','Sempre sul pezzo','Passo dopo passo','Di nuovo in pista','Compagno di percorso']
        && request.resource.data.updatedAt == request.time;
    }
    match /sparkGamePersonal/{u} {
      allow read: if owner(u);
      // Personal XP and cosmetics are private app-calculated progress, not competitive scores.
      allow create, update: if owner(u)
        && request.resource.data.keys().hasOnly(['years','badges','teams','version','updatedAt'])
        && request.resource.data.years is list && request.resource.data.years.size() <= 301
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 7
        && request.resource.data.badges.hasOnly(['first','rhythm','week','fortnight','month','comeback','team'])
        && request.resource.data.teams is map && request.resource.data.teams.size() <= 10000
        && request.resource.data.version == 'diario-spark-1' && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /calendar/{year} {
        allow read: if owner(u);
        allow create, update: if owner(u) && year.matches('^[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['days','version'])
          && request.resource.data.days is map && request.resource.data.days.size() <= 366
          && request.resource.data.version == 'diario-spark-1';
        allow delete: if false;
      }
      match /inbox/{id} {
        allow read: if owner(u);
        allow create, update: if signed() && pointerOK();
        allow delete: if false;
        function pointerOK() {
          let p = request.resource.data;
          let g = getAfter(/databases/$(database)/documents/sparkGameRounds/$(id)).data;
          return request.auth.uid in g.participants && u in g.participants
            && p.keys().hasOnly(['gameId','from','to','peerUid','status','pending','open','until','updatedAt'])
            && p.gameId == id && p.from == g.from && p.to == g.to
            && p.peerUid == (u == g.from ? g.to : g.from) && p.status == g.status
            && p.pending == (g.status == 'pending' && u == g.to)
            && p.open == (g.status in ['pending','active'])
            && p.until == timestamp.value(g.status == 'pending' ? g.expiresMs : g.status == 'active' ? g.settleMs : 0)
            && p.updatedAt == request.time;
        }
      }
    }
    match /sparkGameLocks/{u} {
      allow get: if owner(u) || (signed() && accepted(request.auth.uid,u));
      allow list, delete: if false;
      allow create: if signed() && lockOK();
      allow update: if signed() && lockOK()
        && (resource.data.gameId == request.resource.data.gameId || resource.data.until <= request.time);
      function lockOK() {
        let l = request.resource.data;
        let g = getAfter(/databases/$(database)/documents/sparkGameRounds/$(l.gameId)).data;
        return l.keys().hasOnly(['gameId','until']) && request.auth.uid in g.participants && u in g.participants
          && l.until == timestamp.value(g.status == 'pending' ? g.expiresMs : g.status == 'active' ? g.settleMs : 0);
      }
    }
    match /sparkGameRounds/{id} {
      allow get: if signed() && ((!exists(/databases/$(database)/documents/sparkGameRounds/$(id))) || sparkAccess(resource.data));
      allow list, delete: if false;
      allow create: if signed() && createOK(request.resource.data);
      function createOK(g) {
        return g.keys().hasOnly(['id','from','to','participants','names','status','timezone','rulesVersion','createdAt','expiresMs','updatedAt'])
          && g.id == id && g.from == request.auth.uid && g.to is string && g.to != g.from && g.to.size() <= 128
          && g.participants == [g.from,g.to] && g.names is map && g.names.keys().hasOnly([g.from,g.to])
          && nick(g.names[g.from]) && nick(g.names[g.to]) && g.status == 'pending'
          && g.rulesVersion == 'diario-spark-1' && g.timezone == sparkMember(g.from).timezone
          && g.createdAt == sparkMember(g.from).updatedAt && g.createdAt <= request.time
          && g.createdAt > request.time-duration.value(2,'m')
          && g.expiresMs == g.createdAt.toMillis()+604800000 && g.updatedAt == request.time
          && sparkAccess(g) && locksPoint(g)
          && getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.from)).data.until == timestamp.value(g.expiresMs)
          && getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.to)).data.until == timestamp.value(g.expiresMs);
      }
      allow update: if signed() && request.auth.uid in resource.data.participants
        && request.resource.data.updatedAt == request.time && transitionOK();
      function transitionOK() {
        let old = resource.data;
        let g = request.resource.data;
        let changed = g.diff(old).affectedKeys();
        return (old.status == 'pending' && g.status == 'active' && request.auth.uid == old.to
            && old.expiresMs > request.time.toMillis() && sparkAccess(old)
            && changed.hasOnly(['status','updatedAt','acceptedAt','startDate','endDate','boundaries','startMs','endMs','settleMs'])
            && g.acceptedAt == request.time && windowOK(g) && locksPoint(g)
            && getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.from)).data.until == timestamp.value(g.settleMs)
            && getAfter(/databases/$(database)/documents/sparkGameLocks/$(g.to)).data.until == timestamp.value(g.settleMs))
          || (changed.hasOnly(['status','updatedAt']) && (
            (g.status == 'cancelled' && ((old.status == 'pending' && old.expiresMs > request.time.toMillis()) || (old.status == 'active' && old.settleMs > request.time.toMillis())))
            || (old.status == 'pending' && g.status == 'declined' && request.auth.uid == old.to)
            || (old.status == 'pending' && g.status == 'expired' && old.expiresMs <= request.time.toMillis())
            || (old.status == 'active' && g.status == 'settled' && old.settleMs <= request.time.toMillis())));
      }
      match /days/{key} {
        function game() { return get(/databases/$(database)/documents/sparkGameRounds/$(id)).data; }
        allow get, list: if sparkAccess(game());
        allow create, update: if signed() && dayOK(request.resource.data);
        allow delete: if false;
        function kcalOK(d) {
          return d is map && 'st' in d && 'kcal' in d && d.st is map && 'kcal' in d.st
            && (d.kcal is number || (d.kcal is string && d.kcal.matches('^[0-9]+([.][0-9]+)?$')))
            && float(d.kcal) >= 0 && float(d.kcal) <= 50000
            && ((d.st.kcal == 'completo' && float(d.kcal) > 0) || (d.st.kcal == 'zero_confermato' && float(d.kcal) == 0));
        }
        function dayOK(d) {
          let g = game();
          let privatePath = /databases/$(database)/documents/users/$(request.auth.uid)/days/$(d.date);
          return sparkAccess(g) && g.status == 'active' && request.time.toMillis() < g.settleMs
            && d.keys().hasOnly(['uid','date','index','ok','updatedAt']) && d.uid == request.auth.uid
            && d.index is int && d.index >= 0 && d.index < 7 && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && utcDay(d.date) == utcDay(g.startDate)+d.index*86400000
            && key == d.uid+'~'+d.date && request.time.toMillis() >= g.boundaries[d.index]
            && d.updatedAt == request.time && d.ok is bool
            && d.ok == (exists(privatePath) && kcalOK(getAfter(privatePath).data));
        }
      }
    }

    // Private progress photos: separate from the diary and all social sharing.
    function pvPath(uid) { return /databases/$(database)/documents/privatePhotoVaults/$(uid); }
    function pePath(uid,id) { return /databases/$(database)/documents/privatePhotoVaults/$(uid)/entries/$(id); }
    function paPath(uid,id) { return /databases/$(database)/documents/privatePhotoVaults/$(uid)/assets/$(id); }
    function ppPath() { return /databases/$(database)/documents/privatePhotoCapacity/main; }
    function pvWrapper(w) {
      return w is map && w.keys().hasOnly(['salt','body','iterations'])
        && w.salt is string && w.salt.size() == 24 && w.body is string && w.body.size() >= 80 && w.body.size() <= 200
        && w.iterations == 600000;
    }
    function pvValid(d) {
      return d.keys().hasOnly(['schema','vaultId','password','recovery','prefs','usedBytes','photoCount','lastPhoto','lastAction','updatedAt'])
        && d.schema == 1 && d.vaultId is string && d.vaultId.size() == 24
        && pvWrapper(d.password) && pvWrapper(d.recovery)
        && d.prefs is bytes && d.prefs.size() >= 29 && d.prefs.size() <= 4096
        && d.usedBytes is int && d.usedBytes >= 0 && d.usedBytes <= 25165824
        && d.photoCount is int && d.photoCount >= 0 && d.photoCount <= 156
        && d.lastPhoto is string && d.updatedAt == request.time;
    }
    function pvEntry(e,a) {
      return e.keys().hasOnly(['schema','body','cost']) && e.schema == 1
        && e.body is bytes && e.body.size() >= 29 && e.body.size() <= 65536
        && a.keys().hasOnly(['schema','body']) && a.schema == 1
        && a.body is bytes && a.body.size() >= 29 && a.body.size() <= 196608
        && e.cost is int && e.cost == e.body.size()+a.body.size()+8192;
    }
    function pvMutation(uid,old,d) {
      let id = d.lastPhoto;
      let before = exists(pePath(uid,id));
      let after = existsAfter(pePath(uid,id));
      let oldCost = before ? get(pePath(uid,id)).data.cost : 0;
      let newCost = after ? getAfter(pePath(uid,id)).data.cost : 0;
      let countDelta = (after ? 1 : 0)-(before ? 1 : 0);
      let poolOld = exists(ppPath()) ? get(ppPath()).data : {'usedBytes':0,'photoCount':0};
      let poolNew = getAfter(ppPath()).data;
      return id.matches('^[a-zA-Z0-9_-]{16,64}$')
        && ((d.lastAction == 'add' && !before && after)
          || (d.lastAction == 'replace' && before && after)
          || (d.lastAction == 'delete' && before && !after && !existsAfter(paPath(uid,id))))
        && (!after || pvEntry(getAfter(pePath(uid,id)).data,getAfter(paPath(uid,id)).data))
        && d.usedBytes == old.usedBytes+newCost-oldCost
        && d.photoCount == old.photoCount+countDelta
        && poolNew.usedBytes == poolOld.usedBytes+newCost-oldCost
        && poolNew.photoCount == poolOld.photoCount+countDelta;
    }
    function pvLinked(uid,id) {
      let c = getAfter(pvPath(uid)).data;
      return c.lastPhoto == id && c.lastAction in ['add','replace','delete'] && c.updatedAt == request.time
        && c.updatedAt != get(pvPath(uid)).data.updatedAt;
    }
    match /privatePhotoVaults/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if owner(uid) && pvValid(request.resource.data)
        && request.resource.data.usedBytes == 0 && request.resource.data.photoCount == 0
        && request.resource.data.lastPhoto == '' && request.resource.data.lastAction == 'setup';
      allow update: if owner(uid) && pvValid(request.resource.data)
        && request.resource.data.vaultId == resource.data.vaultId
        && request.resource.data.recovery == resource.data.recovery
        && ((request.resource.data.lastAction == 'password'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password','lastAction','updatedAt']))
        || (request.resource.data.lastAction == 'settings'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs','lastAction','updatedAt']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBytes','photoCount','lastPhoto','lastAction','updatedAt'])
          && pvMutation(uid,resource.data,request.resource.data)));
      match /entries/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && pvLinked(uid,id)
          && pvEntry(request.resource.data,getAfter(paPath(uid,id)).data);
        allow delete: if owner(uid) && pvLinked(uid,id) && getAfter(pvPath(uid)).data.lastAction == 'delete';
      }
      match /assets/{id} {
        allow get: if owner(uid);
        allow list: if false;
        allow create, update: if owner(uid) && pvLinked(uid,id)
          && pvEntry(getAfter(pePath(uid,id)).data,request.resource.data);
        allow delete: if owner(uid) && pvLinked(uid,id) && getAfter(pvPath(uid)).data.lastAction == 'delete';
      }
    }
    match /privatePhotoCapacity/main {
      allow get: if signed();
      allow list, delete: if false;
      allow create, update: if signed()
        && request.resource.data.keys().hasOnly(['usedBytes','photoCount'])
        && request.resource.data.usedBytes is int && request.resource.data.usedBytes >= 0 && request.resource.data.usedBytes <= 402653184
        && request.resource.data.photoCount is int && request.resource.data.photoCount >= 0
        && pvLinked(request.auth.uid,getAfter(pvPath(request.auth.uid)).data.lastPhoto);
    }

  }
}
